* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #d9d9d9;
  font-family: cursive;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
   background-image: url('');
}

.nav-item{
    position: relative;
    top: 0.5rem;
    left: 50%;
    width: calc(100% - 4rem);
    max-width: 1440px;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border: 1px solid #fff;
    border-radius: 20px;
    padding: 1rem;
    background-color: #000000;
}

.logo {
  width: 50px;
  height: 50px;
  border: 1px solid #fff;
  border-radius: 50000%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fff;
}

.logo h1{
  font-size: 1.5rem;
  margin: 0;
  color: #000;
  font-style: italic;
}

.nav-links {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 1rem;
  flex: 1;
  font-size: 1.25rem;
  width: 100%;
}

.nav-links a {
  color: inherit;
  text-decoration: none;
}

.nav-links ul {
  display: flex;
  flex-direction: row;
  flex: 1;
  justify-content: center;
  gap: clamp(1rem, 4vw, 5rem);
  list-style: none;
  padding: 0;
  margin: 0;
  color: #fff;
}

.gmail {
  display: inline-block;
  border: 1px solid #ccc;
  border-radius: 50000px;
  padding: 0.6rem 1rem;
  background-color: #fff;
  font-size: 1.25rem;
}

.gmail p {
  margin: 0;
}

.menu-toggle {
  display: none;
}

@media (max-width: 900px) {
  .nav-item {
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem;
    border-radius: 0px;
  }

  .menu-toggle {
    display: flex;
    width: 44px;
    height: 44px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid #fff;
    border-radius: 12px;
    background: transparent;
    cursor: pointer;
  }

  .menu-toggle span {
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: #fff;
  }

  .nav-links {
    display: none;
    flex: 1 1 100%;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
  }

  .nav-links.is-open {
    display: flex;
  }

  .nav-links ul {
    width: 100%;
    flex-direction: column;
    gap: 20px;
  }

  .nav-links li a {
    display: block;
    padding: 0.75rem 0;
  }

  .gmail {
    width: 100%;

  }

}



@media (max-width: 600px) {
  .nav-item {
    width: calc(100% - 2rem);
    padding: 0.75rem;
    border-radius: 20px;
  }
}

.hero {
  display: grid;
  grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  align-items: center;
  justify-content: center;
  gap: clamp(1rem, 4vw, 2.5rem);
  width: min(100%, 1100px);
  min-height: calc(100vh - 110px);
  margin: 0 auto;
  padding: clamp(1rem, 4vw, 2.5rem);
  position: relative;
}

.phone {
  width: min(100%, 400px);
  height: min(600px, 75vh);
  justify-self: center;
}

.phone img {
  display: block;
  width: 100%;
  height: 70%;
  margin-left: -20%;
  border-radius: 100%;
}

.phone img:hover {
  transform: scale(1.05);
  transition: transform 0.3s ease-in-out;
}

.hero h1 {
  font-size: clamp(2rem, 6vw, 3rem);
  font-weight: 800;
  font-style: italic;
  margin: 0;
}

.hero p {
  font-size: clamp(1rem, 3vw, 1.25rem);
  font-weight: 700;
  font-style: italic;
}

@media (max-width: 900px) {
  .hero {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem;
    min-height: calc(100svh - 100px);
    padding: 1.25rem 1.25rem 2rem;
    align-content: start;
    text-align: center;
  }

  .phone {
    width: min(72vw, 280px);
    height: auto;
  }

  .phone img {
    width: 100%;
    height: auto;
    max-height: 30svh;
    margin-left: 0;
  }

  .hero h1 {
    font-size: clamp(1.75rem, 7vw, 2.5rem);
  }

  .hero p {
    margin: 0.5rem 0 0;
  }
}
